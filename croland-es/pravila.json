  "obrnuti_usklicnik": true,
  "navodnici": [
    "“",
    "”"
  ],
  "zabranjeni_navodnici": [
    "«",
    "»",
    "„",
    "‚"
  ],
  "ravni_navodnici": true,
  "zaostali_engleski": true,
  "rjecnik_izvor": "prijevodi.jsonl",
