  "zabranjeno": [
    {
      "ime": "vosotros-os",
      "regex": "(?i)(?<![\\w-])os(?![\\w-])",
      "koristi": "los / les / se",
      "razlog": "zamjenica vosotros"
    },
    {
      "ime": "vosotros-glagol",
      "regex": "(?i)\\b(?!(?:dieci|veinti)séis\\b)\\w+(?:áis|éis)\\b",
      "koristi": "-an / -en (ustedes)",
      "razlog": "glagolski oblik vosotros"
    },
    {
      "ime": "vosotros-imperativ",
      "regex": "(?i)\\b(?:elegid|tocad|escribid|arrastrad|leed|escuchad|mirad|unid|completad|ordenad|clasificad|responded|decid|haced|poned|traducid|armad|venid|comprobad|pensad|buscad|usad|repetid|jugad|intentad|empezad|seguid|practicad|aprended|hablad|preguntad|contestad|marcad|sentaos|fijaos|acordaos|daos)\\b",
      "koristi": "imperativ tú (Elige, Toca…) ili ustedes (Elijan…)",
      "razlog": "imperativ vosotros"
    },
    {
      "ime": "voseo-vos",
      "regex": "(?i)(?<![\\w-])vos(?![\\w-])",
      "koristi": "tú",
      "razlog": "voseo"
    },
    {
      "ime": "voseo-glagol",
      "regex": "(?i)\\b(?:tenés|querés|podés|sabés|hacés|sentís|decís|venís|vivís|escribís|elegís|sos|fijate|mirá|vení|tocá|escuchá|decime|pensá|probá|andá|contame)\\b",
      "koristi": "oblik za tú",
      "razlog": "voseo"
    },
    {
      "ime": "conducir",
      "regex": "(?i)(?<!licencia de )(?<!licencias de )(?<!licencia \\(de )(?<!licencias \\(de )\\bcondu(?:c(?:ir|í|e|imos|iendo|ido|ió|iste)\\w*|zc\\w*|j\\w+)\\b",
      "koristi": "manejar",
      "razlog": "Španjolska (glagol; conductor, conducta, conducto, conducción i „licencia de conducir“ su u redu)"
    },
    {
      "ime": "coger",
      "regex": "(?i)\\b(?:coger|cojo|coges|coge|cogemos|cogen|cogí|cogió|cogido|cogiendo|coja|cojas|cojan|cógelo|cógela)\\b",
      "koristi": "tomar / agarrar",
      "razlog": "vulgarno u Latinskoj Americi"
    },
    {
      "ime": "vale-uzvik",
      "regex": "(?i)(?:^|[¡¿\\s(—–-])(?<!cuánto )(?<!cuanto )(?<!esto )(?<!eso )(?<!no )(?<!que )(?<!qué )(?<!lo )(?<!más )(?<!menos )(?<!ya no )vale(?=\\s*[!.,?)]|\\s*$)",
      "koristi": "está bien / de acuerdo",
      "razlog": "Španjolska (uzvik; glagol valer – ¿Cuánto vale?, No vale – je u redu)"
    },
    {
      "ime": "echar-de-menos",
      "regex": "(?i)\\bech\\w*\\s+de\\s+menos\\b",
      "koristi": "extrañar",
      "razlog": "Španjolska"
    },
    {
      "ime": "enfadar",
      "regex": "(?i)\\benfad\\w*",
      "koristi": "enojar(se) / enojado / enojo",
      "razlog": "Španjolska"
    },
    {
      "ime": "aparcar",
      "regex": "(?i)\\baparc\\w*",
