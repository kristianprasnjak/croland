# Ovo NIJE datoteka koju čita produkcija. U produkciji tajne žive kao Supabase secrets
# (`supabase secrets set ...`) — vidi SETUP.md, korak 4.
#
# Ovdje su samo za lokalni `supabase functions serve --env-file .env`.
# SUPABASE_URL i SUPABASE_SERVICE_ROLE_KEY se NE navode — Supabase ih sam ubrizgava u svaku
# Edge Function, a prefiks SUPABASE_ je rezerviran pa se ni ne da ručno postaviti.

PADDLE_OKRUZENJE=sandbox
PADDLE_API_KEY=...
PADDLE_WEBHOOK_SECRET=...
PADDLE_PRICE_TJEDAN=pri_...
PADDLE_PRICE_MJESEC=pri_...
PADDLE_PRICE_GODINA=pri_...
PADDLE_PRODUCT_KODOVI=pro_...
# Adresa stranice (s poddirektorijem). Njezino podrijetlo se doda na popis dozvoljenih (CORS).
SITE_URL=http://localhost:8000
