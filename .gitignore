# Build output — regenerated by `npm run build` in the GitHub Actions deploy workflow.
# That workflow's artifact, not what's tracked here, is what's actually publicly served.
dist/

# Node
node_modules/
.env
.env.*
!.env.example

# Supabase CLI local state (linked project, local stack). Tajne žive u Supabase dashboardu,
# nikad ovdje.
supabase/.temp/
supabase/.branches/

# Local dev tooling (e.g. downloaded Stripe CLI binary) — never committed
.tools/

# Genuinely disposable files only — source/working files (.ps1, .txt, .csv, .jsonl, .md,
# data1.js, etc.) stay tracked and double as offsite backup.
*.bak*
__kartice-tmp.html

# Zasticeni sadrzaj — nastaje pri buildu, uploada se rucno u Supabase Storage.
# Ne ide u repozitorij i NIKAD ne smije zavrsiti u dist/.
zasticeno/
