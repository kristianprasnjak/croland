# Build output — regenerated by `npm run build` on every Netlify deploy. This, not what's
# tracked in this private repo, is what determines what's actually publicly served.
dist/

# Node / Netlify local state
node_modules/
.netlify/
.env
.env.*
!.env.example

# Genuinely disposable files only — the repo is private, so source/working files (.ps1, .txt,
# .csv, .jsonl, .md, data1.js, etc.) stay tracked and double as offsite backup.
*.bak*
__kartice-tmp.html
